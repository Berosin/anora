# --- Vector database ---
# If set, connects to a real Qdrant instance (Qdrant Cloud free tier in
# production, or `docker compose up qdrant` for local dev — see the root
# docker-compose.yml). If unset, falls back to an embedded local Qdrant
# instance requiring no server at all.
# QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=
QDRANT_LOCAL_PATH=./qdrant_data

# --- Embeddings ---
# "sentence-transformers" (default) downloads a real model from Hugging
# Face on first use — needs network access once. "deterministic-hash" is
# an offline-only fallback used by the test suite; never use it outside
# of tests (see app/embeddings/embedder.py for why).
EMBEDDING_PROVIDER=sentence-transformers
EMBEDDING_MODEL=all-MiniLM-L6-v2

# --- LLM ---
# "groq" (default) is Groq's free tier — get a key at console.groq.com.
# "ollama" uses a locally running Ollama server instead (no API key
# needed, but you must have Ollama installed and a model pulled).
# "offline-extractive" is a test-only fallback used by the test suite;
# never use it outside of tests (see app/models/llm_provider.py).
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.1:8b
