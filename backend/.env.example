NODE_ENV=development
PORT=5000

# MongoDB Atlas connection string (free M0 cluster). Local fallback shown here.
MONGO_URI=mongodb://127.0.0.1:27017/anora

# Generate a long random string for production — never reuse this value.
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# Must match the deployed frontend origin exactly (no trailing slash).
CORS_ORIGIN=http://localhost:5173

# Base URL of the Python FastAPI AI service.
AI_SERVICE_URL=http://localhost:8000

MAX_UPLOAD_SIZE_MB=20

# Storage backend for uploaded files. "local" writes to backend/uploads/
# (fine for local dev; ephemeral on free hosts like Render). Swap to a
# persistent provider before deploying — see src/services/storage/index.js.
STORAGE_PROVIDER=local
